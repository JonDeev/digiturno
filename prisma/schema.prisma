generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  name          String
  username      String        @unique
  numberId      Int           @unique
  password      String
  role          Role
  moduleId      String?
  createdAt     DateTime      @default(now())
  module        Module?       @relation(fields: [moduleId], references: [id])
  attendedTurns Turn[]        @relation("UserAttendedTurns")
  userServices  UserService[]
}

model Module {
  id     String       @id @default(uuid())
  name   String
  status ModuleStatus @default(AVAILABLE)
  turns  Turn[]
  users  User[]
}

model Service {
  id           String        @id @default(uuid())
  name         String
  code         String
  createdAt    DateTime      @default(now())
  turns        Turn[]
  userServices UserService[]
}

model Turn {
  id                   String     @id @default(uuid())
  number               Int
  code                 String
  serviceId            String
  status               TurnStatus
  priority             Int        @default(0)
  calledCount          Int        @default(0)
  createdAt            DateTime   @default(now())
  calledAt             DateTime?
  moduleId             String?
  fecha_creacion       String?
  attentionStartedAt   DateTime?  // ⬅️ inicio de atención
  attentionFinishedAt  DateTime?  // ⬅️ fin de atención
  attendedById         String?
  module               Module?    @relation(fields: [moduleId], references: [id])
  service              Service    @relation(fields: [serviceId], references: [id])
  attendedBy           User?      @relation("UserAttendedTurns", fields: [attendedById], references: [id])
}

model Media {
  id        Int      @id @default(autoincrement())
  name      String            // Nombre amigable: "Video CAC Citas"
  filename  String            // CACCITA.mp4, asgcita.mp4
  url       String            // /media/CACCITA.mp4 o URL completa http://...
  order     Int      @default(0)   // Orden de reproducción
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model UserService {
  id        Int      @id @default(autoincrement())
  userId    String
  serviceId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  service   Service  @relation(fields: [serviceId], references: [id])

  @@unique([userId, serviceId])
}

model TvConfig {
  id        Int      @id @default(autoincrement())
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ModuleStatus {
  AVAILABLE
  OCCUPIED
}

enum Role {
  ADMIN
  ADVISOR
}

enum TurnStatus {
  PENDING
  CALLED
  ATTENDED
  SKIPPED
  REQUEUED
  ATTENDANCE
}
