generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  numberId  Int      @unique
  password  String
  role      Role
  moduleId  String?
  createdAt DateTime @default(now())
  module    Module?  @relation(fields: [moduleId], references: [id])
}

model Module {
  id     String       @id @default(uuid())
  name   String
  status ModuleStatus @default(AVAILABLE)
  turns  Turn[]
  users  User[]
}

model Service {
  id        String   @id @default(uuid())
  name      String
  code      String
  createdAt DateTime @default(now())
  turns     Turn[]
}

model Turn {
  id             String     @id @default(uuid())
  number         Int
  code           String
  serviceId      String
  status         TurnStatus
  priority       Int        @default(0)
  calledCount    Int        @default(0)
  createdAt      DateTime   @default(now())
  calledAt       DateTime?
  moduleId       String?
  fecha_creacion String?
  module         Module?    @relation(fields: [moduleId], references: [id])
  service        Service    @relation(fields: [serviceId], references: [id])
}

enum ModuleStatus {
  AVAILABLE
  OCCUPIED
}

enum Role {
  ADMIN
  ADVISOR
}

enum TurnStatus {
  PENDING
  CALLED
  ATTENDED
  SKIPPED
  REQUEUED
  ATTENDANCE
}
